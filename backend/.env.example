# Optional: Enables live Gemini structured reasoning, multimodal voice fallback, and TTS.
# Free-Tier Optimization Built In:
# 1. Defaults to high-quota `gemini-3.5-flash-lite` -> `gemini-3.1-flash-lite` -> `gemini-3.8-flash` cascade.
# 2. Persistent SHA-256 DuckDB response cache (repeat claims/questions use 0 API quota).
# 3. Supports pooling multiple free keys across teammates (automatic round-robin + 429 cooldown):
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Or comma-separated: GEMINI_API_KEYS=key1,key2
POLLTOLL_GEMINI_MODEL=gemini-3.5-flash-lite
